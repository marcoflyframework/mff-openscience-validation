title: "MFF OpenScience Validation"
message: "If you use this dataset or analysis, please cite as below."
type: dataset
authors:
  - given-names: "Marco"
    family-names: "Motta"
    orcid: "https://orcid.org/0009-0001-9118-6183"
    affiliation: "MarcoFLY Framework, independent researcher"
